<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the app leaves the last song for the widget (WidgetShare.swift):
	     a keychain item, not an App Group, which the API key cannot register.
	     Must match the second group in App.entitlements exactly. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uk.co.unisim.jukebox.widget</string>
	</array>
</dict>
</plist>
