<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Universal Jukebox</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The app's name wherever iOS names it in a system prompt — "“Universal Jukebox”
	     Wants to Use … to Sign In" among them. Left as $(PRODUCT_NAME) it read
	     "App", the Xcode target's name. Kept equal to CFBundleDisplayName (the
	     home-screen name). -->
	<key>CFBundleName</key>
	<string>Universal Jukebox</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Only HTTPS through the system's own networking, which is exempt, so
	     App Store Connect stops asking the export-compliance question on
	     every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ⚠️ THE APP DOES NOT LAUNCH WITHOUT THIS once it is built against the
	     iOS 27 SDK. iOS terminates an app built against that SDK that still
	     uses the old app-delegate window life cycle, before any of our code
	     runs — "UIScene life cycle is required for apps built with this SDK" in
	     the device log and nothing on screen.

	     The manifest is only half of it: the runtime also checks that the app
	     delegate answers application(_:configurationForConnecting:options:).
	     Both halves, plus SceneDelegate.swift itself, are checked by
	     `npm run check:ios-launch`.

	     Capacitor adopted scenes in 8.5 and this app is on an earlier version,
	     so the three pieces are written out by hand (ported from Universal PDF).
	     There is deliberately NO UISceneStoryboardFile: SceneDelegate builds the
	     window and its bridge view controller itself (it has to, to load the
	     bridge before forwarding a launch link). Naming Main here as well would
	     have UIKit build a second window and bridge from the storyboard. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- ⚠️ THE ONE KEY A MUSIC PLAYER CANNOT SHIP WITHOUT. Without the `audio`
	     background mode iOS suspends the WebView the moment the screen locks or
	     the app is backgrounded, and the music stops — which is the single most
	     obvious way a phone build of this app would be broken, and it looks like
	     a bug in the player rather than a missing entitlement.
	     ⚠️ Declaring it is only HALF the job: the AVAudioSession category must
	     also be `.playback`, which `AppDelegate.swift` sets. A bare declaration
	     here still stops at the lock screen, because the default `.ambient`-ish
	     session Capacitor gets is not allowed to keep playing. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- How music actually GETS onto the phone, and the native answer to the
	     folder this app asks for in a browser. iOS has no directory picker:
	     `showDirectoryPicker` does not exist in WKWebView and `webkitdirectory`
	     is ignored, so "point it at a folder" has to become "here IS your
	     folder". These two keys put the app's Documents directory in the Files
	     app as "Universal Jukebox", where music can be copied, AirDropped,
	     unzipped or synced in — and because those files have stable paths, the
	     library survives a relaunch exactly as the Chromium handle does on the
	     web. `InPlace` lets the user edit/see them where they are rather than
	     only through a copy. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- "Open in Universal Jukebox" from a share sheet, a Mail attachment or a
	     Files long-press. Declared as an Editor of the four container formats
	     the scanner actually reads (see `lib/scan.ts` PLAYABLE) — claiming
	     `public.audio` wholesale would put the app in the list for formats it
	     cannot play, which is a worse experience than not appearing. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Music file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
				<string>org.xiph.flac</string>
				<string>com.microsoft.waveform-audio</string>
			</array>
		</dict>
	</array>
	<!-- The Music app's library: the songs synced to this iPhone from a Mac,
	     read the way Marvis and every other third-party player reads them
	     (`AppleMusicPlugin.swift`). Asked for only when "Use my Music library"
	     is tapped, never at launch. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>Universal Jukebox plays the songs in your Music library that are stored on this iPhone, such as the ones you sync from your computer. Nothing is uploaded.</string>
	<!-- ⚠️ DEFENSIVE, NOT A FEATURE. The web build's folder and file inputs
	     (Landing.tsx, FolderAccessButton.tsx) are bare `<input type="file">`s,
	     and iOS turns one into a sheet offering Photo Library and Take Photo or
	     Video. Inside this app a missing usage string there is not a denied
	     permission — iOS KILLS the process. Those inputs sit behind `!native`
	     today, so the native app never shows them; these strings are here so a
	     future change that does cannot crash it. The app never asks for any of
	     these by itself. -->
	<key>NSCameraUsageDescription</key>
	<string>Universal Jukebox doesn’t use the camera. iOS offers it in the file picker; anything taken there is ignored, because only music files are read. Nothing is uploaded.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Universal Jukebox doesn’t record sound. iOS offers video recording in the file picker; anything recorded there is ignored, because only music files are read. Nothing is uploaded.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Universal Jukebox doesn’t need your photos. iOS offers them in the file picker; anything picked there is ignored, because only music files are read. Nothing is uploaded.</string>
	<!-- ⚠️ A MISSING USAGE STRING IS A CRASH, not a refusal: iOS terminates
	     the process the moment a privacy-gated resource is reached without
	     one (Docs_UNI_SIM/landmines.md).

	     Nothing here calls the camera or the microphone. The web layer's file
	     inputs do, by proxy: the folder pickers are `webkitdirectory` inputs
	     with NO accept (FolderAccessButton, the app menu), which iOS degrades
	     to its generic picker — and that picker offers "Take Photo or Video".
	     Taking a video records sound, so both strings are needed. Those
	     buttons are behind a `!native` branch today, which is one refactor
	     from being live; `npm run check:ios-launch` fails if a camera-reaching
	     input exists in src/ and the camera string does not. -->
	<key>NSCameraUsageDescription</key>
	<string>Universal Jukebox never uses the camera itself. iOS offers it in the file picker; anything you take stays on this device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Universal Jukebox never records sound itself. iOS asks for the microphone only if you take a video from the file picker; it stays on this device.</string>
	<!-- BEGIN unisim suite app links — generated by scripts/add-suite-app-links.mjs, do not hand-edit -->
	<!-- This app's own scheme. Another suite app opens it with
	     unisim-jukebox:// — see UnisimSuiteAuthPlugin.openApp. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uk.co.unisim.jukebox</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unisim-jukebox</string>
			</array>
		</dict>
	</array>
	<!-- Every suite scheme this app may ask about. ⚠️ canOpenURL answers FALSE
	     for anything not listed here and says so only in the device console —
	     which the switcher cannot tell apart from "not installed". The full
	     list is written into every app deliberately: identical blocks make a
	     stale one visible. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>unisim-ergo-assess</string>
		<string>unisim-cyber-assess</string>
		<string>unisim-workplace-assess</string>
		<string>unisim-fire-assess</string>
		<string>unisim-coshh-assess</string>
		<string>unisim-risk-assess</string>
		<string>unisim-pdf</string>
		<string>unisim-images</string>
		<string>unisim-qr</string>
		<string>unisim-compress</string>
		<string>unisim-converter</string>
		<string>unisim-polling</string>
		<string>unisim-blackbook</string>
		<string>unisim-ai</string>
		<string>unisim-jukebox</string>
	</array>
	<!-- END unisim suite app links -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>uk.co.unisim.jukebox.shuffle-songs</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Shuffle songs</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>shuffle</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>uk.co.unisim.jukebox.shuffle-albums</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Shuffle albums</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>square.stack</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>uk.co.unisim.jukebox.shuffle-artists</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Shuffle artists</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>music.mic</string>
		</dict>
	</array>
</dict>
</plist>
