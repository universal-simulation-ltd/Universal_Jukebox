<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Apple's privacy manifest, required for App Store submission.

  The music never leaves the phone: scanning, tags, artwork, shelves, the
  queue and playback all happen on the device. What CAN leave:

  - Signing in with a Universal ID (optional): the email and the account id.
  - While signed in, one "the app was opened" event per launch, tied to the
    account (the SDK's <UsageTracker />). Nothing about the music. Declared as
    product interaction, for analytics, because that is what it is.

  Three lookups send a song's artist and title (never the file) straight from
  the phone to a public service, only when the user asks for what they return:
  LRCLIB for lyrics, Wikipedia for "About this track", and the iTunes Search
  API for a cover on the Requests shelf. None of it reaches our servers or is
  kept against the user, and each request is answered there and then, so
  under Apple's definition it is not collected and is not declared below.

  Nothing is used for tracking, and there are no third-party analytics or
  advertising SDKs.

  Required-reason APIs:
  - UserDefaults: MusicFolderPlugin keeps the security-scoped bookmarks of the
    folders the user picked, read only by this app. CA92.1.
  - File timestamps: MusicFolderPlugin reads the modification date of files in
    the folders the user picked, to rescan only what changed (3B52.1).
    AppleMusicPlugin and @capacitor/filesystem read and set dates on copies in
    the app's own container (C617.1). Neither pod ships a manifest; Capacitor's
    core frameworks carry their own.

  Keep this in step with the App Store Connect privacy answers and
  store-assets/data-safety.json.
-->
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>3B52.1</string>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- The sign-in email. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- One "session.opened" event per launch while signed in. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
